# Google Gemini API Configuration (Get a free key at https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini Model ID (Defaults to gemini-3.5-flash-lite per specification)
GEMINI_MODEL=gemini-3.5-flash-lite

# Local HuggingFace Embedding Model (Runs on CPU / 2GB GPU VRAM friendly)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Gradio Server Configuration
PORT=7860

# =====================================================================
# Optional: YouTube Cloud IP Ban Workaround (Oracle Cloud / AWS / GCP)
# See: https://github.com/jdepoix/youtube-transcript-api#working-around-ip-bans-requestblocked-or-ipblocked-exception
# =====================================================================
# Option 1: Webshare Rotating Residential Proxies (Recommended by youtube-transcript-api)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_LOCATIONS=

# Option 2: Generic HTTP / HTTPS / SOCKS5 Proxy
# Note: When running via docker-compose.yml, this automatically defaults to the free Cloudflare WARP container (socks5h://warp:1080)
YOUTUBE_PROXY_URL=
YOUTUBE_HTTP_PROXY=
YOUTUBE_HTTPS_PROXY=
