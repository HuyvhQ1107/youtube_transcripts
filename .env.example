# Google Gemini API Configuration (Get a free key at https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini Model ID (Defaults to gemini-3.5-flash-lite per specification)
GEMINI_MODEL=gemini-3.5-flash-lite

# Local HuggingFace Embedding Model (Runs on CPU / 2GB GPU VRAM friendly)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Gradio Server Configuration
PORT=7860
